{%- comment -%}
  Reviews. The aggregate and each quote are editable settings so real Judge.me
  reviews can be pasted in — nothing here is generated. Turn on "Use the Judge.me
  widget" to render the live widget beneath instead, once its app embed is enabled.
{%- endcomment -%}

{{ 'prodani-reviews.css' | asset_url | stylesheet_tag }}

<section class="pd-reviews" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor }}"{% endif %}>
  <div class="pd-wrap">
    <div class="pd-sec-head">
      <div>
        <h2 class="pd-sec-title">{{ section.settings.heading | escape }}</h2>
        {% render 'prodani-squiggle' %}
      </div>
      {%- if section.settings.eyebrow != blank -%}
        <span class="pd-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="pd-reviews__grid">
        {%- for block in section.blocks -%}
          <figure class="pd-review" {{ block.shopify_attributes }}>
            <span class="pd-review__stars" aria-label="{{ block.settings.rating }} out of 5">
              {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
            </span>
            {%- if block.settings.title != blank -%}
              <h3 class="pd-review__title">&ldquo;{{ block.settings.title | escape }}&rdquo;</h3>
            {%- endif -%}
            <blockquote class="pd-review__body">{{ block.settings.body | escape }}</blockquote>
            <figcaption class="pd-review__who">
              <span class="pd-review__avatar" aria-hidden="true">{{ block.settings.author | slice: 0 | upcase }}</span>
              <span>
                <b>{{ block.settings.author | escape }}</b>
                <i>{{ block.settings.note | default: 'Verified buyer' | escape }}</i>
              </span>
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_widget -%}
      {%- comment -%}
        Judge.me's all-reviews widget renders from shop.metafields.judgeme.*, which
        is server-side, so the full list is present even before their app-embed JS
        loads. The embed only adds styling and the star webfont.
      {%- endcomment -%}
      <details class="pd-reviews__more">
        <summary class="pd-btn pd-btn--outline">
          <span class="pd-reviews__more-open">{{ section.settings.more_label | escape }}</span>
          <span class="pd-reviews__more-close">{{ section.settings.less_label | escape }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </summary>
        <div class="pd-reviews__widget" id="judgeme_all_reviews_page">
          {% render 'judgeme_all_reviews' %}
        </div>
      </details>
    {%- endif -%}

    {%- comment -%} 2026-09-01: the "Shop the collection" CTA was removed on
        request (all viewports) — this section keeps a single action, the
        Read-all-reviews toggle above. {%- endcomment -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "pd-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people say" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "reviews" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Verified · Judge.me" },
    {
      "type": "checkbox", "id": "show_widget", "label": "Also show the live Judge.me list",
      "info": "Renders the full Judge.me list inside a More reviews panel.", "default": true
    },
    { "type": "text", "id": "more_label", "label": "Expand label", "default": "Read all reviews" },
    { "type": "text", "id": "less_label", "label": "Collapse label", "default": "Show fewer" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "author", "label": "Name" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Headline" },
        { "type": "textarea", "id": "body", "label": "Review" },
        { "type": "text", "id": "note", "label": "Caption under the name", "default": "Verified buyer" }
      ]
    }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}

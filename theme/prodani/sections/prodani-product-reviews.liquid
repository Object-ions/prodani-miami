{%- comment -%}
  Judge.me reviews for one product.

  The homepage renders the store-wide feed from shop.metafields.judgeme.all_reviews_*.
  A product page needs the per-product widget instead, and Judge.me offers two ways
  to place it: an app block dropped in the theme editor, or this markup.

  This is the markup route, on purpose. The app-block route needs the extension's
  UUID inside a `shopify://apps/...` URI, and when that URI is wrong Shopify drops
  the block silently — the page renders fine and the reviews simply are not there,
  which is the worst possible failure for something a shopper is meant to read.

  The div is the contract: judgeme_core (enabled in settings_data.json) finds any
  .jdgm-widget on the page and hydrates it. The metafield is printed inside it so
  the reviews are in the HTML on first paint rather than appearing a beat later;
  when it is empty, the script fetches them instead. Either way the widget works.
{%- endcomment -%}

{{ 'prodani-product-reviews.css' | asset_url | stylesheet_tag }}

<section class="pd-prevs"
         {% if section.settings.anchor != blank %}id="{{ section.settings.anchor }}"{% endif %}>
  <div class="pd-wrap">
    <div class="pd-sec-head">
      <div>
        <h2 class="pd-sec-title">{{ section.settings.heading | escape }}</h2>
        {% render 'prodani-squiggle' %}
      </div>
      {%- if section.settings.eyebrow != blank -%}
        <span class="pd-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
    </div>

    <div class="pd-prevs__widget">
      <div class="jdgm-widget jdgm-review-widget"
           data-product-title="{{ product.title | escape }}"
           data-id="{{ product.id }}">
        {{ product.metafields.judgeme.reviews }}
      </div>
    </div>

    {%- comment -%}
      A shopper who has not bought this one yet still deserves a way through to
      everything else people have said.
    {%- endcomment -%}
    {%- if section.settings.all_reviews_url != blank -%}
      <p class="pd-prevs__all">
        <a href="{{ section.settings.all_reviews_url }}">
          {{ section.settings.all_reviews_label | default: 'Read every review' | escape }}
          <svg width="22" height="12" viewBox="0 0 22 12" fill="none" aria-hidden="true">
            <path d="M21.53 6.53a.75.75 0 0 0 0-1.06L16.76.7a.75.75 0 1 0-1.06 1.06L19.94 6l-4.24 4.24a.75.75 0 1 0 1.06 1.06l4.77-4.77ZM0 6.75h21v-1.5H0v1.5Z" fill="currentColor"/>
          </svg>
        </a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "class": "pd-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people said" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "VERIFIED · JUDGE.ME" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "reviews" },
    { "type": "url", "id": "all_reviews_url", "label": "Link to all reviews" },
    { "type": "text", "id": "all_reviews_label", "label": "Link label", "default": "Read every review" }
  ],
  "presets": [{ "name": "Product reviews" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}

{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "pd_rating": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'prodani-pdp-rating' %}"
          }
        },
        "pd_macros": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'prodani-pdp-macros' %}"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "pd_subscribe": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'prodani-subscribe' %}"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "pd_trust": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'prodani-pdp-trust' %}"
          }
        },
        "description": {
          "type": "description"
        },
        "pd_info": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'prodani-pdp-info' %}"
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "pd_sticky": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'prodani-sticky-atc' %}"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "pd_rating",
        "pd_macros",
        "price",
        "variant_picker",
        "pd_subscribe",
        "quantity_selector",
        "buy_buttons",
        "pd_trust",
        "description",
        "pd_info",
        "share",
        "pd_sticky"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "reviews": {
      "type": "prodani-product-reviews",
      "settings": {
        "heading": "What people said",
        "eyebrow": "VERIFIED · JUDGE.ME",
        "anchor": "reviews",
        "all_reviews_url": "/#reviews",
        "all_reviews_label": "Read all 132 reviews"
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Complete your box",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "reviews",
    "related-products"
  ]
}
